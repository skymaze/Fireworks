# DGX Spark Agent systemd unit（由 deploy.sh 生成，此文件为模板参考）
[Unit]
Description=DGX Spark Agent (Fireworks)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/dgx-agent/venv/bin/uvicorn main:app --host 0.0.0.0 --port 9000
WorkingDirectory=/opt/dgx-agent
Environment=DGX_AGENT_PORT=9000
Environment=DGX_AGENT_WORKDIR=/opt/dgx-agent/work
Restart=always
RestartSec=3
StandardOutput=append:/opt/dgx-agent/agent.log
StandardError=append:/opt/dgx-agent/agent.log

[Install]
WantedBy=multi-user.target
