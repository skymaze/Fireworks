# Fireworks Agent systemd unit（由 deploy.sh 生成，此文件为模板参考）
[Unit]
Description=Fireworks Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/fireworks-agent/venv/bin/uvicorn main:app --host 0.0.0.0 --port 9000
WorkingDirectory=/opt/fireworks-agent
Environment=FW_AGENT_PORT=9000
Environment=FW_AGENT_WORKDIR=/opt/fireworks-agent/work
Restart=always
RestartSec=3
StandardOutput=append:/opt/fireworks-agent/agent.log
StandardError=append:/opt/fireworks-agent/agent.log

[Install]
WantedBy=multi-user.target
