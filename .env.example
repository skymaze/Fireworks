# ===== Fireworks 控制平面配置示例 =====
# 复制为 .env 并按需修改；后端会读取以下变量

# 数据库（SQLite 文件路径，容器内挂载在 /data）
DATABASE_URL=sqlite:////data/fireworks.db

# 指标采集
METRIC_POLL_INTERVAL=5        # 每多少秒轮询一次节点 Agent（秒）
METRIC_RETENTION_HOURS=24     # 指标保留时长（小时），超出自动清理

# Agent 相关
AGENT_PORT=9000               # 节点上 Agent 默认监听端口
AGENT_DEPLOY_DIR=/opt/fireworks-agent  # Agent 数据目录（容器 /data 挂载点）

# ---- 认证与安全 ----
# 登录会话有效期（小时），到期需重新登录
# SESSION_TTL_HOURS=168

# 允许跨域来源（逗号分隔，默认 http://localhost:3000）；同源部署基本不参与
# CORS_ORIGINS=http://localhost:3000

# HTTPS 部署时设为 1，登录 cookie 加 Secure 标记（HTTP 部署勿开）
# COOKIE_SECURE=1
