# ===== Fireworks 生产 Compose 配置示例 =====
# 复制为 .env 后按实际环境修改。Compose 会自动读取仓库根目录的 .env。

# 固定镜像版本，避免无意中跟随 latest 升级。
FW_IMAGE_TAG=0.13.0

# HTTPS 保持 1；仅在本机或可信内网的纯 HTTP 部署中改为 0。
COOKIE_SECURE=1

# 推理监控默认保留 25 小时：24 小时统计窗口 + 窗口前差分基线。
# INFERENCE_RETENTION_HOURS=25

# 默认留空时使用 Docker 命名卷。大模型环境建议取消注释，并改成真实且容量足够的
# 宿主机绝对路径。各操作系统的目录创建和检查命令见 README「部署与存储」。
# Linux:
# FIREWORKS_DB_PATH=/var/lib/fireworks/db
# FIREWORKS_CACHE_PATH=/mnt/large-disk/fireworks/cache
# macOS Docker Desktop（数据库建议保留命名卷，只绑定缓存）：
# FIREWORKS_CACHE_PATH=/Volumes/ModelDisk/FireworksCache
# Windows Docker Desktop（数据库建议保留命名卷；Compose 路径使用正斜杠）：
# FIREWORKS_CACHE_PATH=D:/FireworksCache

# 自建镜像仓库时按需覆盖；普通 GHCR / 阿里云部署无需设置。
# IMAGE_REGISTRY=registry.example.com
# IMAGE_OWNER=team
